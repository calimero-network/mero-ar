# Rust
logic/target/
logic/res/
# `cargo mero bundle` output (signed .mpk)
logic/dist/

# merobox's per-run node state (rocksdb, blobs, the copied .mpk). Written into
# workflows/ by `merobox bootstrap run`, so a plain `git add workflows` sweeps
# a whole node's database into the commit.
workflows/data/

# Swift / SwiftPM
.build/
*.xcodeproj
*.xcworkspace
DerivedData/
.swiftpm/

# Generated by dev scripts
app/.env.integration
app/.env.integration.bak

# macOS
.DS_Store

# Node home / logs (created under $HOME and /tmp, but ignore any local copies)
*.log
